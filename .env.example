# --- Frontend KiwiDL / Saltwake Docks Settings ---
# Leave VITE_API_BASE empty to run in Demo / Standalone Mode (no backend required).
# To connect to your backend, point this to your API instance (e.g. https://api.kiwiapi.net).
VITE_API_BASE=""

# Optional API key sent in the 'X-API-Key' header when calling the backend.
VITE_API_KEY=""

# --- Optional AI Studio Settings ---
# Required only if calling Gemini AI API endpoints.
GEMINI_API_KEY=""

# App hosting URL (used in self-referencing callbacks or cloud environments)
APP_URL="http://localhost:3000"
