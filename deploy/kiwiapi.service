[Unit]
Description=KiwiAPI FastAPI Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kiwi
Group=kiwi
WorkingDirectory=/opt/kiwiapi/api
EnvironmentFile=/opt/kiwiapi/.env
ExecStart=/opt/kiwiapi/api/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
LimitNOFILE=65535

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateDevices=true
ReadWritePaths=/var/lib/kiwiapi

[Install]
WantedBy=multi-user.target
