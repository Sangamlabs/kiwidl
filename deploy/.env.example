# Generate strong random keys with: openssl rand -hex 24

# Comma-separated partner API keys accepted in X-API-Key
API_KEYS=REPLACE_WITH_PARTNER_KEY_1,REPLACE_WITH_PARTNER_KEY_2

# Single public key embedded in dl.kiwiapi.net (Origin-locked and IP rate-limited)
WEB_KEY=REPLACE_WITH_WEB_KEY

# Comma-separated CORS origins allowed to call the API
ALLOWED_ORIGINS=https://dl.kiwiapi.net

# Folder where temporary downloaded files are stored (deleted after 30 minutes)
TMP_DIR=/var/lib/kiwiapi/tmp

# Maximum lifetime of a temporary file in seconds (1800 = 30 minutes)
MAX_SECONDS=1800
